---
/**
 * ControlZebra Grid — Hybrid Design
 *
 * Fuses Technical Grid's structural precision (edge-to-edge border grid,
 * monospace metadata, flat dark surfaces, numbered indices) with the
 * ControlZebra landing page's atmospheric depth (radial gradient glows,
 * grid overlay, ladder logic diff visualization, industrial warmth).
 *
 * Fonts: DM Sans (display + body), IBM Plex Mono (technical)
 * Palette: Deep slate (#12161c) → amber (#d4a446) accent → green (#4fad56) status
 * Mood: Industrial spec-sheet meets atmospheric product marketing
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ControlZebra | Version Control for the Factory Floor</title>
    <meta name="description" content="A fast, visual Git client purpose-built for PLC engineers. Compare ladder logic diffs, rollback safely, and sync when ready." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ═══════════════════════════════════════════
         TOKENS
         ═══════════════════════════════════════════ */
      :root {
        --bg:           #12161c;
        --bg-warm:      #161a21;
        --surface:      #1a1f27;
        --surface-2:    #20262f;
        --surface-glow: rgba(212, 164, 70, 0.04);
        --border:       rgba(148, 163, 184, 0.12);
        --border-strong: rgba(148, 163, 184, 0.22);
        --text:         #e4e8ed;
        --text-2:       #c0c8d2;
        --muted:        #7b8694;
        --accent:       #d4a446;
        --accent-dim:   #b5903c;
        --accent-glow:  rgba(212, 164, 70, 0.14);
        --green:        #4fad56;
        --green-dim:    rgba(79, 173, 86, 0.12);
        --red:          #c05252;
        --red-dim:      rgba(192, 82, 82, 0.10);
        --content:      1200px;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        font-family: 'DM Sans', system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* ── Atmospheric overlays (from landing page) ── */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(ellipse 60% 40% at 10% 5%, rgba(212, 164, 70, 0.10), transparent),
          radial-gradient(ellipse 40% 30% at 90% 8%, rgba(79, 173, 86, 0.06), transparent);
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image:
          linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, transparent 60%);
      }

      a { color: inherit; text-decoration: none; }

      .relative { position: relative; z-index: 1; }

      /* ═══════════════════════════════════════════
         NAV — Technical Grid style, edge-to-edge
         ═══════════════════════════════════════════ */
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 48px;
        height: 56px;
        border-bottom: 1px solid var(--border);
        position: relative;
        z-index: 10;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .nav-brand {
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: 0.02em;
        color: var(--text);
      }

      .nav-tag {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.58rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--accent);
        padding: 3px 8px;
        border: 1px solid rgba(212, 164, 70, 0.25);
        border-radius: 3px;
        line-height: 1;
      }

      .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        align-items: center;
      }

      .nav-links a {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        color: var(--muted);
        transition: color 180ms;
      }

      .nav-links a:hover { color: var(--accent); }

      .nav-cta {
        padding: 8px 20px;
        background: var(--accent);
        color: var(--bg);
        font-family: 'DM Sans', sans-serif;
        font-weight: 600;
        font-size: 0.75rem;
        letter-spacing: 0.02em;
        border-radius: 4px;
        transition: background 180ms, transform 140ms;
      }

      .nav-cta:hover { background: var(--accent-dim); transform: translateY(-1px); }

      /* ═══════════════════════════════════════════
         HERO — Split grid + ladder logic visual
         ═══════════════════════════════════════════ */
      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 86vh;
        border-bottom: 1px solid var(--border);
      }

      .hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px 64px;
        position: relative;
      }

      .hero-status {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 40px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.70rem;
        letter-spacing: 0.06em;
        color: var(--accent);
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 8px rgba(79, 173, 86, 0.5);
        animation: pulse-dot 2.4s ease-in-out infinite;
      }

      @keyframes pulse-dot {
        0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(79, 173, 86, 0.5); }
        50% { opacity: 0.6; box-shadow: 0 0 12px rgba(79, 173, 86, 0.3); }
      }

      h1 {
        font-weight: 700;
        font-size: clamp(2.8rem, 4.8vw, 4.4rem);
        line-height: 1;
        letter-spacing: -0.02em;
        margin-bottom: 28px;
      }

      h1 .accent { color: var(--accent); }

      .hero-desc {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--muted);
        max-width: 44ch;
        margin-bottom: 40px;
      }

      .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 600;
        font-size: 0.84rem;
        letter-spacing: 0.02em;
        border-radius: 4px;
        transition: background 180ms, transform 140ms, box-shadow 180ms;
        box-shadow: 0 8px 24px rgba(212, 164, 70, 0.18);
      }

      .btn-primary:hover {
        background: var(--accent-dim);
        transform: translateY(-1px);
        box-shadow: 0 12px 32px rgba(212, 164, 70, 0.24);
      }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        border: 1px solid var(--border-strong);
        border-radius: 4px;
        color: var(--text-2);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        transition: border-color 180ms, color 180ms;
      }

      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

      /* ── Hero visual — desktop shell mock ─────── */
      .hero-visual {
        border-left: 1px solid var(--border);
        background:
          radial-gradient(ellipse 80% 60% at 50% 50%, var(--surface-glow), transparent),
          var(--surface);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 48px 0 48px 40px;
        position: relative;
        overflow: hidden;
      }



      .desktop-shell {
        width: 100%;
        max-width: 720px;
        background: #0f1319;
        border: 1px solid var(--border-strong);
        border-right: none;
        border-radius: 10px 0 0 10px;
        overflow: hidden;
        box-shadow:
          0 24px 60px rgba(0, 0, 0, 0.45),
          0 0 0 1px rgba(255, 255, 255, 0.02);
        animation: float-in 0.8s ease-out both;
        position: relative;
      }

      /* ── Screenshot image (cropped to left 70%) ── */
      .desktop-screenshot-wrap {
        position: relative;
        line-height: 0;
        overflow: hidden;
      }

      .desktop-screenshot {
        width: 142.86%; /* 100 / 0.70 — shows left 70% of image */
        max-width: none;
        height: auto;
      }

      @keyframes float-in {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* ── Theme toggle switch for screenshots ── */
      .theme-switch {
        position: absolute;
        top: 16px;
        right: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 5;
        color: var(--muted);
      }

      .theme-switch svg {
        width: 13px;
        height: 13px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
        transition: color 180ms;
      }

      .theme-switch .icon-sun { color: var(--muted); }
      .theme-switch .icon-moon { color: var(--accent); }
      [data-screenshot-theme="light"] .theme-switch .icon-sun { color: var(--accent); }
      [data-screenshot-theme="light"] .theme-switch .icon-moon { color: var(--muted); }

      .switch-track {
        position: relative;
        width: 36px;
        height: 20px;
        background: var(--surface-2);
        border: 1px solid var(--border-strong);
        border-radius: 10px;
        cursor: pointer;
        transition: border-color 180ms;
      }

      .switch-track:hover { border-color: var(--accent); }

      .switch-knob {
        position: absolute;
        top: 2px;
        left: 2px;
        width: 14px;
        height: 14px;
        background: var(--accent);
        border-radius: 50%;
        transition: transform 200ms ease;
        transform: translateX(16px);
      }

      [data-screenshot-theme="light"] .switch-knob {
        transform: translateX(0);
      }

      .screenshot-img-dark { display: block; }
      .screenshot-img-light { display: none; }
      [data-screenshot-theme="light"] .screenshot-img-dark { display: none; }
      [data-screenshot-theme="light"] .screenshot-img-light { display: block; }

      /* ═══════════════════════════════════════════
         METRICS BAND — Technical Grid signature
         ═══════════════════════════════════════════ */
      .metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-bottom: 1px solid var(--border);
      }

      .metric {
        padding: 40px 32px;
        border-right: 1px solid var(--border);
        text-align: center;
        transition: background 280ms;
      }

      .metric:last-child { border-right: none; }
      .metric:hover { background: var(--surface-glow); }

      .metric-val {
        font-weight: 700;
        font-size: 1.65rem;
        color: var(--accent);
        letter-spacing: -0.01em;
      }

      .metric-label {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 0.68rem;
        font-weight: 500;
        text-transform: uppercase;
        color: var(--muted);
        letter-spacing: 0.08em;
        margin-top: 10px;
      }

      /* ═══════════════════════════════════════════
         SECTION SYSTEM
         ═══════════════════════════════════════════ */
      .section-header {
        padding: 80px 56px 0;
        max-width: 56ch;
      }

      .label {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.10em;
        color: var(--accent);
        margin-bottom: 12px;
      }

      h2 {
        font-weight: 700;
        font-size: clamp(1.6rem, 2.8vw, 2.2rem);
        line-height: 1.08;
        letter-spacing: -0.01em;
        margin-bottom: 16px;
      }

      .section-header p {
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.98rem;
      }

      h3 {
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
      }

      /* ═══════════════════════════════════════════
         FEATURES — 3-col grid from Technical Grid
         ═══════════════════════════════════════════ */
      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-bottom: 1px solid var(--border);
      }

      .feat {
        padding: 56px;
        border-right: 1px solid var(--border);
        transition: background 280ms;
      }

      .feat:last-child { border-right: none; }
      .feat:hover { background: var(--surface-glow); }

      .feat-idx {
        font-family: 'IBM Plex Mono', monospace;
        font-weight: 600;
        font-size: 0.68rem;
        color: var(--accent);
        letter-spacing: 0.04em;
        margin-bottom: 22px;
      }

      .feat h3 { margin-bottom: 14px; }

      .feat p {
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.92rem;
      }

      /* ═══════════════════════════════════════════
         DIFF CALLOUT — Bullet panel
         Merges Landing Page bullet chips + Technical Grid layout
         ═══════════════════════════════════════════ */
      .callout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .callout-copy {
        padding: 80px 64px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .callout-copy h2 { margin-bottom: 20px; }

      .callout-copy > p {
        color: var(--muted);
        line-height: 1.65;
        max-width: 40ch;
      }

      .callout-visual {
        border-left: 1px solid var(--border);
        background:
          radial-gradient(ellipse 80% 60% at 50% 50%, var(--surface-glow), transparent),
          var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
        position: relative;
        overflow: hidden;
      }

      .diff-shell {
        width: 100%;
        max-width: 640px;
        background: #0f1319;
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        overflow: hidden;
        box-shadow:
          0 24px 60px rgba(0, 0, 0, 0.45),
          0 0 0 1px rgba(255, 255, 255, 0.02);
      }

      .diff-screenshot-wrap {
        position: relative;
        line-height: 0;
        overflow: hidden;
      }

      .diff-screenshot {
        width: 100%;
        height: auto;
      }

      /* ═══════════════════════════════════════════
         WORKFLOW — File Manager screenshot
         ═══════════════════════════════════════════ */
      .workflow {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .workflow-copy {
        padding: 80px 64px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .workflow-copy h2 { margin-bottom: 20px; }

      .workflow-copy > p {
        color: var(--muted);
        line-height: 1.65;
        max-width: 42ch;
      }

      .workflow-visual {
        border-left: 1px solid var(--border);
        background:
          radial-gradient(ellipse 80% 60% at 50% 50%, var(--surface-glow), transparent),
          var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
        position: relative;
        overflow: hidden;
      }

      .files-shell {
        width: 100%;
        max-width: 640px;
        background: #0f1319;
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        overflow: hidden;
        box-shadow:
          0 24px 60px rgba(0, 0, 0, 0.45),
          0 0 0 1px rgba(255, 255, 255, 0.02);
      }

      .files-screenshot-wrap {
        position: relative;
        line-height: 0;
        overflow: hidden;
      }

      .files-screenshot {
        width: 100%;
        height: auto;
      }

      /* ═══════════════════════════════════════════
         INFRASTRUCTURE — Checklist split
         ═══════════════════════════════════════════ */
      .infra {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .infra-copy {
        padding: 80px 64px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .infra-copy h2 { margin-bottom: 20px; }

      .infra-copy > p {
        color: var(--muted);
        line-height: 1.65;
        max-width: 40ch;
      }

      .infra-checks {
        padding: 56px;
        background: var(--surface);
        border-left: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 16px;
        justify-content: center;
      }

      .check-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 14px;
        align-items: start;
        padding: 20px 22px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        transition: border-color 200ms;
      }

      .check-row:hover { border-color: rgba(79, 173, 86, 0.25); }

      .check-icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--green-dim);
        color: var(--green);
        border-radius: 3px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        font-weight: 600;
        margin-top: 1px;
      }

      .check-row p {
        color: var(--text-2);
        font-size: 0.92rem;
        line-height: 1.55;
      }

      .check-row strong {
        color: var(--text);
        font-weight: 600;
      }

      /* ═══════════════════════════════════════════
         PERSONAS — 3-col + accent bars
         ═══════════════════════════════════════════ */
      .personas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-bottom: 1px solid var(--border);
      }

      .persona {
        padding: 56px;
        border-right: 1px solid var(--border);
        transition: background 280ms;
      }

      .persona:last-child { border-right: none; }
      .persona:hover { background: var(--surface-glow); }

      .persona-bar {
        width: 36px;
        height: 3px;
        background: linear-gradient(90deg, var(--accent), var(--accent-dim));
        margin-bottom: 24px;
        border-radius: 2px;
      }

      .persona h3 { margin-bottom: 14px; }

      .persona p {
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.92rem;
      }

      /* ═══════════════════════════════════════════
         CTA
         ═══════════════════════════════════════════ */
      .cta {
        padding: 100px 56px;
        text-align: center;
        border-bottom: 1px solid var(--border);
        position: relative;
      }

      .cta::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 50% 60% at 50% 100%, rgba(212, 164, 70, 0.06), transparent);
      }

      .cta h2 {
        font-size: clamp(1.8rem, 3.2vw, 2.5rem);
        margin-bottom: 20px;
      }

      .cta h2 .accent { color: var(--accent); }

      .cta > p {
        color: var(--muted);
        margin-bottom: 40px;
        font-size: 1.02rem;
      }

      .cta-note {
        margin-top: 20px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.66rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }

      /* ═══════════════════════════════════════════
         FOOTER — Technical Grid monospace
         ═══════════════════════════════════════════ */
      .site-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 28px 48px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.66rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }

      .footer-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .footer-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--accent);
        opacity: 0.5;
      }

      .back-link {
        color: var(--muted);
        text-decoration: none;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        transition: color 180ms;
      }

      .back-link:hover { color: var(--accent); }

      /* ═══════════════════════════════════════════
         SCROLL REVEAL
         ═══════════════════════════════════════════ */
      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ═══════════════════════════════════════════
         RESPONSIVE
         ═══════════════════════════════════════════ */
      @media (max-width: 960px) {
        .hero,
        .callout,
        .workflow,
        .infra,
        .features,
        .personas,
        .metrics {
          grid-template-columns: 1fr;
        }

        .feat,
        .persona,
        .metric {
          border-right: none;
          border-bottom: 1px solid var(--border);
        }

        .feat:last-child,
        .persona:last-child,
        .metric:last-child {
          border-bottom: none;
        }

        .hero-visual,
        .callout-visual,
        .workflow-visual,
        .infra-checks {
          border-left: none;
          border-right: none;
          border-top: 1px solid var(--border);
        }

        .nav { padding: 0 24px; }
        .hero-copy,
        .callout-copy,
        .workflow-copy,
        .infra-copy,
        .section-header { padding: 56px 28px; }
        .section-header { padding-bottom: 0; }
        .hero-visual,
        .callout-visual,
        .workflow-visual,
        .infra-checks { padding: 40px 28px; }
        .feat, .persona { padding: 40px 28px; }
        .cta { padding: 72px 28px; }

        .nav-links { display: none; }
      }

      @media (max-width: 640px) {
        .desktop-shell {
          border-radius: 4px;
        }

