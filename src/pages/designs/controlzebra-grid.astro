---
/**
 * ControlZebra Grid — Hybrid Design
 *
 * Fuses Technical Grid's structural precision (edge-to-edge border grid,
 * structured metadata, flat dark surfaces, numbered indices) with the
 * ControlZebra landing page's atmospheric depth (radial gradient glows,
 * grid overlay, ladder logic diff visualization, industrial warmth).
 *
 * Font: IBM Plex Sans
 * Palette: Deep slate (#12161c) → amber (#d4a446) accent → green (#4fad56) status
 * Mood: Industrial spec-sheet meets atmospheric product marketing
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ControlZebra | Version Control for the Factory Floor"
  description="A fast, visual Git client purpose-built for PLC engineers. Compare ladder logic diffs, rollback safely, and sync when ready."
  themeColor="#12161c"
  bodyClass="controlzebra-grid"
>
  <style>
      /* ═══════════════════════════════════════════
         TOKENS
         ═══════════════════════════════════════════ */
      :root {
        --bg:           #12161c;
        --bg-warm:      #161a21;
        --surface:      #1a1f27;
        --surface-2:    #20262f;
        --surface-glow: rgba(212, 164, 70, 0.04);
        --border:       rgba(148, 163, 184, 0.12);
        --border-strong: rgba(148, 163, 184, 0.22);
        --text:         #e4e8ed;
        --text-2:       #c0c8d2;
        --muted:        #7b8694;
        --accent:       #d4a446;
        --accent-dim:   #b5903c;
        --accent-glow:  rgba(212, 164, 70, 0.14);
        --green:        #4fad56;
        --green-dim:    rgba(79, 173, 86, 0.12);
        --red:          #c05252;
        --red-dim:      rgba(192, 82, 82, 0.10);
        --content:      1200px;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        font-family: 'IBM Plex Sans', 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* ── Atmospheric overlays (from landing page) ── */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(ellipse 60% 40% at 10% 5%, rgba(212, 164, 70, 0.10), transparent),
          radial-gradient(ellipse 40% 30% at 90% 8%, rgba(79, 173, 86, 0.06), transparent);
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image:
          linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, transparent 60%);
      }

      a { color: inherit; text-decoration: none; }

      .relative { position: relative; z-index: 1; }

      /* ═══════════════════════════════════════════
         NAV — Technical Grid style, edge-to-edge
         ═══════════════════════════════════════════ */
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 48px;
        height: 56px;
        border-bottom: 1px solid var(--border);
        position: relative;
        z-index: 10;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .nav-brand {
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        color: var(--text);
      }

      .nav-tag {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--accent);
        padding: 3px 8px;
        border: 1px solid rgba(212, 164, 70, 0.25);
        border-radius: 3px;
        line-height: 1;
      }

      .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        align-items: center;
      }

      .nav-links a {
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--muted);
        transition: color 180ms;
      }

      .nav-links a:hover { color: var(--accent); }

      .nav-cta {
        padding: 8px 20px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        border-radius: 4px;
        transition: background 180ms, transform 140ms;
      }

      .nav-cta:hover { background: var(--accent-dim); transform: translateY(-1px); }

      /* ═══════════════════════════════════════════
         HERO — Split grid + ladder logic visual
         ═══════════════════════════════════════════ */
      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 86vh;
        border-bottom: 1px solid var(--border);
      }

      .hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 72px 56px;
        position: relative;
      }

      .hero-status {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 36px;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--accent);
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 8px rgba(79, 173, 86, 0.5);
        animation: pulse-dot 2.4s ease-in-out infinite;
      }

      @keyframes pulse-dot {
        0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(79, 173, 86, 0.5); }
        50% { opacity: 0.6; box-shadow: 0 0 12px rgba(79, 173, 86, 0.3); }
      }

      h1 {
        font-weight: 700;
        font-size: clamp(2.8rem, 4.8vw, 4.4rem);
        line-height: 1;
        letter-spacing: -0.02em;
        margin-bottom: 24px;
      }

      h1 .accent { color: var(--accent); }

      .hero-desc {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--muted);
        max-width: 44ch;
        margin-bottom: 40px;
      }

      .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: 0.02em;
        border-radius: 4px;
        transition: background 180ms, transform 140ms, box-shadow 180ms;
        box-shadow: 0 8px 24px rgba(212, 164, 70, 0.18);
      }

      .btn-primary:hover {
        background: var(--accent-dim);
        transform: translateY(-1px);
        box-shadow: 0 12px 32px rgba(212, 164, 70, 0.24);
      }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        border: 1px solid var(--border-strong);
        border-radius: 4px;
        color: var(--text-2);
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        transition: border-color 180ms, color 180ms;
      }

      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

      /* ── Hero visual — ladder logic diff ──────── */
      .hero-visual {
        border-left: 1px solid var(--border);
        background:
          radial-gradient(ellipse 80% 60% at 50% 50%, var(--surface-glow), transparent),
          var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 40px;
        position: relative;
        overflow: hidden;
      }

      /* Faint corner coordinates — technical detail */
      .hero-visual::before {
        content: '48.8566° N, 2.3522° E';
        position: absolute;
        top: 16px;
        right: 20px;
        font-size: 0.75rem;
        font-weight: 500;
        color: rgba(148, 163, 184, 0.18);
        letter-spacing: 0.06em;
      }

      .diff-panel {
        width: 100%;
        max-width: 520px;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        overflow: hidden;
        animation: float-in 0.8s ease-out both;
      }

      @keyframes float-in {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .diff-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }

      .diff-title {
        font-size: 0.86rem;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: 0.04em;
      }

      .diff-badge {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 3px 8px;
        border-radius: 3px;
        background: var(--accent-glow);
        color: var(--accent);
        border: 1px solid rgba(212, 164, 70, 0.2);
      }

      .diff-body { padding: 0; }

      .diff-panes {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .diff-pane {
        padding: 16px;
      }

      .diff-pane + .diff-pane {
        border-left: 1px solid var(--border);
      }

      .pane-label {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--muted);
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
      }

      /* Ladder rails (from landing page) */
      .ladder {
        display: grid;
        grid-template-columns: 20px 1fr;
        gap: 8px;
      }

      .rail {
        position: relative;
        min-height: 180px;
      }

      .rail::before,
      .rail::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(200, 210, 220, 0.35);
      }

      .rail::before { left: 3px; }
      .rail::after { right: 3px; }

      .rungs { display: grid; gap: 10px; }

      .rung {
        display: grid;
        grid-template-columns: 28px 1fr auto;
        gap: 6px;
        align-items: center;
        padding: 8px 10px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.015);
        transition: background 180ms;
      }

      .contact-sym {
        width: 22px;
        height: 12px;
        border-left: 2px solid var(--text-2);
        border-right: 2px solid var(--text-2);
      }

      .wire-sym {
        height: 1.5px;
        background: rgba(200, 210, 220, 0.35);
      }

      .instr {
        font-size: 0.8rem;
        font-weight: 500;
        padding: 5px 8px;
        border-radius: 3px;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .instr-stable {
        color: var(--text-2);
        background: rgba(148, 163, 184, 0.06);
        border: 1px solid rgba(148, 163, 184, 0.12);
      }

      .rung-remove {
        background: var(--red-dim);
        outline: 1px solid rgba(192, 82, 82, 0.18);
      }

      .rung-add {
        background: var(--green-dim);
        outline: 1px solid rgba(79, 173, 86, 0.18);
      }

      .instr-remove {
        color: #e8a0a0;
        background: rgba(192, 82, 82, 0.16);
        border: 1px solid rgba(192, 82, 82, 0.25);
      }

      .instr-add {
        color: #a0dea4;
        background: rgba(79, 173, 86, 0.16);
        border: 1px solid rgba(79, 173, 86, 0.25);
      }

      /* ═══════════════════════════════════════════
         METRICS BAND — Technical Grid signature
         ═══════════════════════════════════════════ */
      .metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-bottom: 1px solid var(--border);
      }

      .metric {
        padding: 28px 32px;
        border-right: 1px solid var(--border);
        text-align: center;
        transition: background 280ms;
      }

      .metric:last-child { border-right: none; }
      .metric:hover { background: var(--surface-glow); }

      .metric-val {
        font-weight: 700;
        font-size: 1.65rem;
        color: var(--accent);
        letter-spacing: -0.01em;
      }

      .metric-label {
        font-size: 0.82rem;
        color: var(--muted);
        letter-spacing: 0.04em;
        margin-top: 6px;
      }

      /* ═══════════════════════════════════════════
         SECTION SYSTEM
         ═══════════════════════════════════════════ */
      .section-header {
        padding: 56px 56px 0;
        max-width: 56ch;
      }

      .label {
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--accent);
        margin-bottom: 12px;
      }

      h2 {
        font-weight: 700;
        font-size: clamp(1.6rem, 2.8vw, 2.2rem);
        line-height: 1.08;
        letter-spacing: -0.01em;
        margin-bottom: 12px;
      }

      .section-header p {
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.98rem;
      }

      h3 {
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
      }

      /* ═══════════════════════════════════════════
         FEATURES — 3-col grid from Technical Grid
         ═══════════════════════════════════════════ */
      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-bottom: 1px solid var(--border);
      }

      .feat {
        padding: 48px;
        border-right: 1px solid var(--border);
        transition: background 280ms;
      }

      .feat:last-child { border-right: none; }
      .feat:hover { background: var(--surface-glow); }

      .feat-idx {
        font-weight: 600;
        font-size: 0.84rem;
        color: var(--accent);
        letter-spacing: 0.08em;
        margin-bottom: 18px;
      }

      .feat h3 { margin-bottom: 10px; }

      .feat p {
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.92rem;
      }

      /* ═══════════════════════════════════════════
         DIFF CALLOUT — Bullet panel
         Merges Landing Page bullet chips + Technical Grid layout
         ═══════════════════════════════════════════ */
      .callout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .callout-copy {
        padding: 64px 56px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .callout-copy h2 { margin-bottom: 14px; }

      .callout-copy > p {
        color: var(--muted);
        line-height: 1.65;
        max-width: 40ch;
      }

      .callout-list {
        padding: 48px;
        background: var(--surface);
        border-left: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 12px;
        justify-content: center;
      }

      .callout-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 14px;
        align-items: start;
        padding: 16px 18px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        transition: border-color 200ms, background 200ms;
      }

      .callout-row:hover {
        border-color: rgba(212, 164, 70, 0.2);
        background: var(--surface-glow);
      }

      .callout-chip {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 4px 10px;
        border-radius: 3px;
        color: var(--bg);
        background: var(--accent);
        line-height: 1;
        margin-top: 2px;
      }

      .callout-row p {
        color: var(--text-2);
        font-size: 0.92rem;
        line-height: 1.55;
      }

      /* ═══════════════════════════════════════════
         WORKFLOW — Step cards in grid
         ═══════════════════════════════════════════ */
      .workflow {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .workflow-copy {
        padding: 64px 56px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .workflow-copy h2 { margin-bottom: 14px; }

      .workflow-copy > p {
        color: var(--muted);
        line-height: 1.65;
        max-width: 42ch;
      }

      .workflow-steps {
        padding: 48px;
        background: var(--surface);
        border-left: 1px solid var(--border);
      }

      .step {
        display: grid;
        grid-template-columns: 40px 1fr;
        gap: 16px;
        padding: 22px 0;
        border-bottom: 1px solid var(--border);
        animation: step-in 0.4s ease-out both;
      }

      .step:last-child { border-bottom: none; }

      @keyframes step-in {
        from { opacity: 0; transform: translateX(12px); }
        to { opacity: 1; transform: translateX(0); }
      }

      .step:nth-child(1) { animation-delay: 0.05s; }
      .step:nth-child(2) { animation-delay: 0.12s; }
      .step:nth-child(3) { animation-delay: 0.19s; }
      .step:nth-child(4) { animation-delay: 0.26s; }

      .step-num {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--surface-2);
        border: 1px solid var(--border-strong);
        border-radius: 4px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--accent);
      }

      .step-title {
        font-weight: 600;
        font-size: 0.88rem;
        margin-bottom: 4px;
        color: var(--text);
      }

      .step p {
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.55;
      }

      /* ═══════════════════════════════════════════
         INFRASTRUCTURE — Checklist split
         ═══════════════════════════════════════════ */
      .infra {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .infra-copy {
        padding: 64px 56px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .infra-copy h2 { margin-bottom: 14px; }

      .infra-copy > p {
        color: var(--muted);
        line-height: 1.65;
        max-width: 40ch;
      }

      .infra-checks {
        padding: 48px;
        background: var(--surface);
        border-left: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 12px;
        justify-content: center;
      }

      .check-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 14px;
        align-items: start;
        padding: 16px 18px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        transition: border-color 200ms;
      }

      .check-row:hover { border-color: rgba(79, 173, 86, 0.25); }

      .check-icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--green-dim);
        color: var(--green);
        border-radius: 3px;
        font-size: 0.82rem;
        font-weight: 600;
        margin-top: 1px;
      }

      .check-row p {
        color: var(--text-2);
        font-size: 0.92rem;
        line-height: 1.55;
      }

      .check-row strong {
        color: var(--text);
        font-weight: 600;
      }

      /* ═══════════════════════════════════════════
         PERSONAS — 3-col + accent bars
         ═══════════════════════════════════════════ */
      .personas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-bottom: 1px solid var(--border);
      }

      .persona {
        padding: 48px;
        border-right: 1px solid var(--border);
        transition: background 280ms;
      }

      .persona:last-child { border-right: none; }
      .persona:hover { background: var(--surface-glow); }

      .persona-icon {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border: 1px solid rgba(212, 164, 70, 0.2);
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(212, 164, 70, 0.1), rgba(212, 164, 70, 0.03));
        color: var(--accent);
      }

      .persona-icon svg {
        width: 24px;
        height: 24px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .persona-bar {
        width: 36px;
        height: 3px;
        background: linear-gradient(90deg, var(--accent), var(--accent-dim));
        margin-bottom: 20px;
        border-radius: 2px;
      }

      .persona h3 { margin-bottom: 10px; }

      .persona p {
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.92rem;
      }

      /* ═══════════════════════════════════════════
         CTA
         ═══════════════════════════════════════════ */
      .cta {
        padding: 80px 56px;
        text-align: center;
        border-bottom: 1px solid var(--border);
        position: relative;
      }

      .cta::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 50% 60% at 50% 100%, rgba(212, 164, 70, 0.06), transparent);
      }

      .cta h2 {
        font-size: clamp(1.8rem, 3.2vw, 2.5rem);
        margin-bottom: 14px;
      }

      .cta h2 .accent { color: var(--accent); }

      .cta > p {
        color: var(--muted);
        margin-bottom: 32px;
        font-size: 1.02rem;
      }

      .cta-note {
        margin-top: 14px;
        font-size: 0.88rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }

      /* ═══════════════════════════════════════════
         FOOTER — Technical Grid
         ═══════════════════════════════════════════ */
      .site-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 48px;
        font-size: 0.88rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }

      .footer-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .footer-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--accent);
        opacity: 0.5;
      }

      .back-link {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9rem;
