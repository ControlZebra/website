---
const metrics = [
  { value: 'Unlimited', label: 'PLC backups' },
  { value: 'Zero', label: 'Server setups' },
  { value: '100%', label: 'github compatible' },
  { value: 'L5X', label: 'Native support' },
];
---

<section class="metrics reveal">
  {
    metrics.map((metric) => (
      <div class="metric">
        <div class="metric-val">{metric.value}</div>
        <div class="metric-label">{metric.label}</div>
      </div>
    ))
  }
</section>