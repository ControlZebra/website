---
const metrics = [
  { value: '2s', label: 'Avg diff render' },
  { value: '0', label: 'Servers required' },
  { value: '100%', label: 'Offline capable' },
  { value: 'L5X', label: 'Native support' },
];
---

<section class="metrics reveal">
  {
    metrics.map((metric) => (
      <div class="metric">
        <div class="metric-val">{metric.value}</div>
        <div class="metric-label">{metric.label}</div>
      </div>
    ))
  }
</section>