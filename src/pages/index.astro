---
import ScreenshotShowcase from '../components/home/ScreenshotShowcase.astro';
import SectionHeader from '../components/home/SectionHeader.astro';
import MetricsStrip from '../components/home/MetricsStrip.astro';
import PersonaCards from '../components/home/PersonaCards.astro';
import CtaBlock from '../components/home/CtaBlock.astro';
import HomeScripts from '../components/home/HomeScripts.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const features = [
  {
    index: '01',
    title: 'Visual Diff Engine',
    description:
      'See exactly which rungs changed. Side-by-side comparison highlights added, removed, and modified instructions instantly.',
  },
  {
    index: '02',
    title: 'One-Click Rollback',
    description:
      'Made a mistake during commissioning? Rollback to any previous version with a single click. Your safety net for the adventure you choose.',
  },
  {
    index: '03',
    title: 'Simplified Merge',
    description:
      'No more git merge complexity. We got you covered with guided merge workflow.',
  },
];

const infraChecks = [
  {
    heading: 'GitHub ready.',
    description: 'Connects to the platforms you already use.',
  },
  {
    heading: 'Light-weight app (~17 MB).',
    description: 'No bulky installations or background services slowing down your laptop.',
  },
  {
    heading: 'Offline-first.',
    description: 'Commit your changes in the field and sync when you are back on the network.',
  },
];
---

<BaseLayout
  title="ControlZebra | Version Control for the Factory Floor"
  description="A fast, visual Git client purpose-built for automation engineers. Compare ladder logic diffs, rollback safely, and sync when ready."
  themeColor="#12161c"
  bodyClass="homepage"
>
  <div class="home-shell">
    <nav class="nav">
      <div class="nav-left">
        <div class="nav-brand">ControlZebra</div>
        <span class="nav-tag">Public Beta</span>
      </div>
      <ul class="nav-links">
        <li><a href="/docs/">Documentation</a></li>
      </ul>
      <a href="#download" class="nav-cta">Download</a>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <h1>Version Control for the <span class="accent">Factory Floor</span></h1>
        <p class="hero-desc">
          A fast, visual Git client purpose-built for automation engineers. Compare ladder logic diffs,
          rollback safely, and sync when ready &mdash; no software expertise required.
        </p>
        <div class="hero-actions">
          <a href="/docs/" class="btn-ghost">Read documentation</a>
          <a href="#download" class="btn-primary">Download for Windows</a>
        </div>
      </div>

      <ScreenshotShowcase
        containerClass="hero-visual"
        shellClass="desktop-shell"
        wrapperClass="desktop-screenshot-wrap"
        imageClass="desktop-screenshot"
        darkSrc="/img/app-screenshot-dark-1600.png"
        darkSrcSet="/img/app-screenshot-dark-1600.png 1600w, /img/app-screenshot-dark.png 2936w"
        lightSrc="/img/app-screenshot-light-1600.png"
        lightSrcSet="/img/app-screenshot-light-1600.png 1600w, /img/app-screenshot-light.png 2940w"
        sizes="(max-width: 960px) 100vw, 1030px"
        alt="ControlZebra desktop application screenshot"
        loading="eager"
        fetchPriority="high"
        width={2940}
        height={1848}
      />
    </section>

    <MetricsStrip />

    <SectionHeader title="Basics done right..." />
    <section class="features reveal" id="features">
      {
        features.map((feature) => (
          <div class="feat">
            <div class="feat-idx">{feature.index}</div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))
      }
    </section>

    <section class="callout reveal">
      <div class="callout-copy">
        <h2>See exactly what changed.</h2>
        <p>
          Stop guessing which rung was modified. The standalone engine renders PLC logic at exceptional
          speed, so you can compare two versions side-by-side and understand every change in seconds.
        </p>
      </div>
      <ScreenshotShowcase
        containerClass="callout-visual"
        shellClass="diff-shell"
        wrapperClass="diff-screenshot-wrap"
        imageClass="diff-screenshot"
        darkSrc="/img/diff-screenshot-dark.png"
        lightSrc="/img/diff-screenshot-light.png"
        alt="ControlZebra diff view screenshot"
        loading="lazy"
        width={1246}
        height={322}
      />
    </section>

    <section class="workflow reveal" id="workflow">
      <ScreenshotShowcase
        containerClass="workflow-visual"
        shellClass="files-shell"
        wrapperClass="files-screenshot-wrap"
        imageClass="files-screenshot"
        darkSrc="/img/files-screenshot-dark.png"
        darkSrcSet="/img/files-screenshot-dark-1600.png 1600w, /img/files-screenshot-dark.png 2940w"
        lightSrc="/img/files-screenshot-light.png"
        lightSrcSet="/img/files-screenshot-light-1600.png 1600w, /img/files-screenshot-light.png 2940w"
        sizes="(max-width: 960px) calc(100vw - 56px), 640px"
        alt="ControlZebra file browser screenshot"
        loading="lazy"
        width={2940}
        height={1846}
      />
      <div class="workflow-copy">
        <h2>A file manager you already know.</h2>
        <p>
          No terminal. No jargon. Open your project folders, preview changes, and manage versions
          &mdash; all from an interface that feels like a cloud file browser.
        </p>
      </div>
    </section>

    <section class="infra reveal">
      <div class="infra-copy">
        <h2>Professional control. Zero complexity.</h2>
        <p>You do not need to be a software developer to use professional version control.</p>
      </div>
      <div class="infra-checks">
        {
          infraChecks.map((item) => (
            <div class="infra-check-row">
              <span class="infra-check-icon">+</span>
              <p><strong>{item.heading}</strong> {item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <SectionHeader title="Different jobs. One Shared Source of Truth." />
    <PersonaCards />
    <CtaBlock />

    <footer class="home-site-footer">
      <div class="home-footer-left">
        <span>ControlZebra &copy; 2026</span>
        <span class="home-footer-dot"></span>
        <span>PLC version control with visual diff</span>
      </div>
      <span>ControlZebra Grid</span>
    </footer>
  </div>

  <HomeScripts />
</BaseLayout>