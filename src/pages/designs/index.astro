---
/**
 * Design Gallery — ControlZebra Grid
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ControlZebra | Design Gallery"
  description="Experimental ControlZebra marketing page directions and gallery previews."
  themeColor="#0e0e10"
  bodyClass="design-gallery"
>
  <style>
      :root {
        --bg: #0E0E10;
        --surface: #18181B;
        --surface-hover: #1F1F23;
        --border: #27272A;
        --text: #FAFAFA;
        --text-muted: #A1A1AA;
        --text-dim: #71717A;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'IBM Plex Sans', 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; text-decoration: none; }

      .shell {
        width: min(calc(100% - 48px), 1100px);
        margin: 0 auto;
        padding: 48px 0;
      }

      /* Header */
      .gallery-header {
        text-align: center;
        padding: 60px 0 72px;
      }

      .gallery-brand {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--text-dim);
        margin-bottom: 20px;
      }

      h1 {
        font-size: clamp(2.8rem, 5vw, 4.2rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 16px;
      }

      .gallery-sub {
        font-size: 1.05rem;
        color: var(--text-muted);
        max-width: 52ch;
        margin: 0 auto;
        line-height: 1.6;
      }

      /* Card grid */
      .card-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 20px;
      }

      .design-card {
        display: grid;
        grid-template-rows: auto 1fr;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 300ms ease, box-shadow 300ms ease, border-color 300ms ease;
      }

      .design-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 48px rgba(0,0,0,0.3);
      }

      .card-czgrid:hover { border-color: #d4a446; box-shadow: 0 24px 48px rgba(212,164,70,0.12); }

      /* Preview area */
      .card-preview {
        height: 320px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .preview-czgrid {
        background: #12161c;
        position: relative;
      }

      .preview-czgrid::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse 60% 40% at 20% 30%, rgba(212,164,70,0.08), transparent),
          radial-gradient(ellipse 40% 30% at 80% 20%, rgba(79,173,86,0.05), transparent);
        pointer-events: none;
      }

      .preview-czgrid::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.5), transparent 80%);
        pointer-events: none;
      }

      /* Preview content */
      .preview-label {
        position: relative;
        z-index: 1;
        font-size: 1.6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .label-czgrid {
        color: #d4a446;
        text-shadow: 0 0 24px rgba(212,164,70,0.25);
        font-weight: 800;
      }

      /* Card info */
      .card-info {
        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .card-info h3 {
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .card-info p {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.55;
      }

      .card-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 4px;
      }

      .card-tag {
        padding: 4px 12px;
        background: rgba(255,255,255,0.06);
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--text-dim);
      }

      .card-arrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-dim);
        margin-top: auto;
        padding-top: 8px;
        transition: color 200ms;
      }

      .design-card:hover .card-arrow { color: var(--text); }

      /* Footer */
      .gallery-footer {
        text-align: center;
        padding: 48px 0;
        border-top: 1px solid var(--border);
        margin-top: 48px;
      }

      .footer-text {
        font-size: 0.85rem;
        color: var(--text-dim);
        margin-bottom: 8px;
      }

      .footer-brand {
        font-size: 1rem;
        font-weight: 700;
      }

      .current-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 24px;
        border: 1px solid var(--border);
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-top: 24px;
        transition: border-color 200ms, color 200ms;
      }

      .current-link:hover { border-color: var(--text-muted); color: var(--text); }

      @media (max-width: 720px) {
        .card-preview { height: 200px; }
        .gallery-header { padding: 40px 0 48px; }
      }
  </style>
  <div class="shell">
      <header class="gallery-header">
        <div class="gallery-brand">ControlZebra</div>
        <h1>Design Gallery</h1>
        <p class="gallery-sub">
          Experimental landing page concepts have been removed. The current production site remains available below.
        </p>
      </header>

      <div class="card-grid">
        <div class="design-card">
          <div class="card-info">
            <h3>No experimental routes published</h3>
            <p>The design sandbox is no longer exposed as a public route. Use the current site as the source of truth.</p>
            <span class="card-arrow">Archived concept removed</span>
          </div>
        </div>
      </div>

      <footer class="gallery-footer">
        <div class="footer-brand">ControlZebra</div>
        <a href="/" class="current-link">View current site &rarr;</a>
      </footer>
  </div>
</BaseLayout>
